{"_id": "page-our-water", "_type": "page", "description": "How water in Finland gets its soft, clean character.", "sections": [{"_key": "p005", "_type": "pageHeroSection", "accent": "kept by the untouched ground.", "eyebrow": "Our water", "heading": "Shaped by ice,", "image": {"_type": "image", "asset": {"_ref": "image-bd0e56f4585071e78484b6feb0dcaa5935b707fd-2000x1500-jpg", "_type": "reference"}}, "lede": "How water in Finland gets its soft, clean character: a story that starts in the last Ice Age and ends in your can.", "wide": false}, {"_key": "p006", "_type": "storySection", "accent": "aluminium can.", "button": {"_type": "link", "href": "https://cdn.shopify.com/s/files/1/0972/1158/0680/files/Fiskars_vesiraportti.pdf", "label": "Read the water quality report (PDF)"}, "eyebrow": "Six chapters", "heading": "From ice sheet to", "layout": "chapters", "steps": [{"_key": "p007", "_type": "step", "illustration": "ice", "text": "In the last Ice Age, a sheet of ice kilometres thick covered Finland and ground the bedrock into sand and gravel.", "title": "Ice made the land"}, {"_key": "p008", "_type": "step", "illustration": "ridges", "text": "As the ice melted, rivers inside it laid down long ridges of sorted sand and gravel. They still run across Finland.", "title": "Ridges of sand and gravel"}, {"_key": "p009", "_type": "step", "illustration": "rain", "text": "Every spring, melting snow and rain soak slowly down into the ground.", "title": "Rain and snowmelt"}, {"_key": "p010", "_type": "step", "illustration": "filter", "text": "Sinking through layers of sand and gravel, the water is filtered naturally and becomes groundwater.", "title": "Filtered by the ground"}, {"_key": "p011", "_type": "step", "illustration": "soft", "text": "Finland's old, hard bedrock gives away few minerals, so the water stays soft and clean-tasting.", "title": "Naturally soft"}, {"_key": "p012", "_type": "step", "illustration": "ahti", "text": "In Finnish myth, Ahti is king of the waters. We like to think every can gets his nod.", "title": "Blessed by Ahti"}]}, {"_key": "p013", "_type": "rangeSection", "eyebrow": "Taste it", "heading": "Three waters, one vessel.", "lede": "Still, Sparkling and Vadelma, in 330ml and 500ml cans.", "products": [{"_key": "p014", "_ref": "product-vadelma", "_type": "reference"}, {"_key": "p015", "_ref": "product-still", "_type": "reference"}, {"_key": "p016", "_ref": "product-sparkling", "_type": "reference"}]}, {"_key": "p001", "_type": "cardsSection", "cards": [{"_key": "p002", "_type": "linkCard", "eyebrow": "Find AHTI", "href": "#", "image": {"_type": "image", "asset": {"_ref": "image-b9c15e9478ac1e33c5a0383683da2e112c523ef9-1600x2000-jpg", "_type": "reference"}}, "text": "AHTI is available in K-food stores across Finland.", "title": "In stores near you"}, {"_key": "p003", "_type": "linkCard", "eyebrow": "Collaborations", "href": "#", "image": {"_type": "image", "asset": {"_ref": "image-8bf262b6d4ee9ac72df8e3308900b85d9a2c721d-1600x2000-jpg", "_type": "reference"}}, "text": "Festivals, fashion, hospitality and brand partnerships.", "title": "Make something together"}, {"_key": "p004", "_type": "linkCard", "eyebrow": "Stock AHTI", "href": "#", "image": {"_type": "image", "asset": {"_ref": "image-bd0e56f4585071e78484b6feb0dcaa5935b707fd-2000x1500-jpg", "_type": "reference"}}, "text": "Retail, HoReCa, distribution and export enquiries.", "title": "Bring AHTI to your shelves"}], "heading": "Wherever you find us."}], "slug": {"_type": "slug", "current": "our-water"}, "title": "Our water"}
{"_id": "page-our-story", "_type": "page", "title": "Our story", "slug": {"_type": "slug", "current": "our-story"}, "description": "AHTI is a water brand from Helsinki: soft Finnish water in aluminium cans.", "sections": [{"_type": "pageHeroSection", "_key": "s033", "eyebrow": "Our story", "heading": "Finnish water,", "accent": "made to travel.", "lede": "AHTI is a water brand from Helsinki. Soft Finnish water in aluminium cans, still, sparkling or with a single note of raspberry, made to be wherever people gather.", "button": {"_type": "link", "label": "Shop the waters", "href": "/#range"}, "image": {"_type": "image", "asset": {"_type": "reference", "_ref": "image-b9c15e9478ac1e33c5a0383683da2e112c523ef9-1600x2000-jpg"}}, "wide": false}, {"_type": "splitSection", "_key": "s034", "eyebrow": "The name", "heading": "Named for the", "accent": "king of the waters.", "body": "In Finnish mythology, Ahti rules the lakes, rivers and seas. Fishermen once asked for his favour before heading out on the water.\n\nThe name felt right for a water from the North, and his face became our emblem.", "media": "image", "image": {"_type": "image", "asset": {"_type": "reference", "_ref": "image-8bf262b6d4ee9ac72df8e3308900b85d9a2c721d-1600x2000-jpg"}}, "flip": false}, {"_type": "splitSection", "_key": "s035", "eyebrow": "The can", "heading": "Why a", "accent": "can?", "body": "A can keeps out light and air, chills quickly and travels well, from a festival field to a dinner table.\n\nThree waters, one vessel: Still, Sparkling and Vadelma, each in 330ml and 500ml.", "button": {"_type": "link", "label": "Meet the range", "href": "/#range"}, "media": "cans", "products": [{"_type": "reference", "_key": "s036", "_ref": "product-still"}, {"_type": "reference", "_key": "s037", "_ref": "product-sparkling"}, {"_type": "reference", "_key": "s038", "_ref": "product-vadelma"}], "flip": true}, {"_type": "splitSection", "_key": "s039", "eyebrow": "Out in the world", "heading": "From backstage", "accent": "to the front row.", "body": "You will find AHTI backstage at festivals, on Helsinki runways and at dinner tables, at Food Expo Hong Kong, and now in selected K-food stores across Finland.", "media": "image", "image": {"_type": "image", "asset": {"_type": "reference", "_ref": "image-b792f417f325205a8d10b5942acdb629a17f1d46-2000x1400-jpg"}}, "flip": false}, {"_key": "s001", "_type": "storySection", "button": {"_type": "link", "label": "Read the whole story", "href": "/pages/our-water"}, "eyebrow": "Our water", "heading": "Shaped by ice,", "steps": [{"_key": "s002", "_type": "step", "illustration": "ice", "text": "In the last Ice Age, a sheet of ice kilometres thick covered Finland and ground the bedrock into sand and gravel.", "title": "Ice made the land"}, {"_key": "s003", "_type": "step", "illustration": "ridges", "text": "As the ice melted, rivers inside it laid down long ridges of sorted sand and gravel. They still run across Finland.", "title": "Ridges of sand"}, {"_key": "s004", "_type": "step", "illustration": "rain", "text": "Every spring, melting snow and rain soak slowly down into the ground.", "title": "Rain and snowmelt"}, {"_key": "s005", "_type": "step", "illustration": "filter", "text": "Sinking through layers of sand and gravel, the water is filtered naturally and becomes groundwater.", "title": "Filtered by the ground"}, {"_key": "s006", "_type": "step", "illustration": "soft", "text": "Finland's old, hard bedrock gives away few minerals, so the water stays soft and clean-tasting.", "title": "Naturally soft"}, {"_key": "s007", "_type": "step", "illustration": "ahti", "text": "In Finnish myth, Ahti is king of the waters. We like to think every can gets his nod.", "title": "Blessed by Ahti"}], "accent": "kept by the untouched ground.", "layout": "rail"}, {"_key": "s008", "_type": "marqueeSection", "items": [{"_key": "s009", "_type": "marqueeItem", "name": "Kesko"}, {"_key": "s010", "_type": "marqueeItem", "name": "Helsinki City Festival"}, {"_key": 