{"_id": "homePage", "_type": "homePage", "sections": [{"_key": "k022", "_type": "heroSection", "aside": "Still, sparkling and Vadelma. Made to be served cold.", "button": {"_type": "link", "href": "#range", "label": "Discover the waters"}, "eyebrow": "AHTI · Finnish water, canned", "image": {"_type": "image", "asset": {"_ref": "image-d49ee9dbd2a2d2cc43ca560df014be77de20456c-2400x1350-jpg", "_type": "reference"}}, "titleLines": ["Nordic purity.", "Beautifully alive."]}, {"_key": "k023", "_type": "marqueeSection", "items": [{"_key": "k024", "_type": "marqueeItem", "name": "Kesko"}, {"_key": "k025", "_type": "marqueeItem", "name": "Helsinki City Festival"}, {"_key": "k026", "_type": "marqueeItem", "name": "Sipoonjoen Perinnesauna"}, {"_key": "k027", "_type": "marqueeItem", "name": "ARGImarket"}, {"_key": "k028", "_type": "marqueeItem", "name": "Iso-Syöte"}, {"_key": "k029", "_type": "marqueeItem", "name": "Helsingin Sanomat"}, {"_key": "k030", "_type": "marqueeItem", "name": "Cœur Studios"}, {"_key": "k031", "_type": "marqueeItem", "name": "Tapiola"}], "label": "As seen at"}, {"_key": "k032", "_type": "introSection", "button": {"_type": "link", "href": "/pages/our-water", "label": "Our water story"}, "eyebrow": "Finnish water, canned", "facts": [{"_key": "k033", "_type": "fact", "key": "Source", "value": "Finland"}, {"_key": "k034", "_type": "fact", "key": "Character", "value": "Naturally soft"}, {"_key": "k035", "_type": "fact", "key": "Vessel", "value": "Aluminium can"}], "heading": "Water at its most essential, shaped by the North.", "images": [{"_key": "k036", "_type": "image", "asset": {"_ref": "image-b9c15e9478ac1e33c5a0383683da2e112c523ef9-1600x2000-jpg", "_type": "reference"}}, {"_key": "k037", "_type": "image", "asset": {"_ref": "image-b792f417f325205a8d10b5942acdb629a17f1d46-2000x1400-jpg", "_type": "reference"}}, {"_key": "k038", "_type": "image", "asset": {"_ref": "image-bd0e56f4585071e78484b6feb0dcaa5935b707fd-2000x1500-jpg", "_type": "reference"}}], "lede": "Cold, clear and quiet: still, sparkling or with a single note of raspberry. AHTI puts Finnish water in an aluminium can and keeps everything else out of the way.", "sealText": "Finnish water · canned · "}, {"_key": "k039", "_type": "rangeSection", "eyebrow": "The range", "heading": "Three waters, one vessel.", "lede": "Still, Sparkling and Vadelma, in 330ml and 500ml cans.", "products": [{"_key": "k040", "_ref": "product-vadelma", "_type": "reference"}, {"_key": "k041", "_ref": "product-still", "_type": "reference"}, {"_key": "k042", "_ref": "product-sparkling", "_type": "reference"}]}, {"_key": "k043", "_type": "storySection", "button": {"_type": "link", "href": "/pages/our-water", "label": "Read the whole story"}, "eyebrow": "Our water", "heading": "Shaped by ice, kept by the untouched ground.", "steps": [{"_key": "k044", "_type": "step", "illustration": "ice", "text": "In the last Ice Age, a sheet of ice kilometres thick covered Finland and ground the bedrock into sand and gravel.", "title": "Ice made the land"}, {"_key": "k045", "_type": "step", "illustration": "ridges", "text": "As the ice melted, rivers inside it laid down long ridges of sorted sand and gravel. They still run across Finland.", "title": "Ridges of sand"}, {"_key": "k046", "_type": "step", "illustration": "rain", "text": "Every spring, melting snow and rain soak slowly down into the ground.", "title": "Rain and snowmelt"}, {"_key": "k047", "_type": "step", "illustration": "filter", "text": "Sinking through layers of sand and gravel, the water is filtered naturally and becomes groundwater.", "title": "Filtered by the ground"}, {"_key": "k048", "_type": "step", "illustration": "soft", "text": "Finland's old, hard bedrock gives away few minerals, so the water stays soft and clean-tasting.", "title": "Naturally soft"}, {"_key": "k049", "_type": "step", "illustration": "ahti", "text": "In Finnish myth, Ahti is king of the waters. We like to think every can gets his nod.", "title": "Blessed by Ahti"}]}, {"_key": "k050", "_type": "socialSection", "eyebrow": "Real life", "followTitle": "Follow AHTI on Instagram", "handle": {"_type": "link", "href": "https://www.instagram.com/ahtiwater/", "label": "@ahtiwater"}, "heading": "Out in the world.", "items": [{"_key": "k051", "_type": "socialItem", "caption": "Helsinki Fashion Evening", "href": "https://www.instagram.com/ahtiwater/", "image": {"_type": "image", "asset": {"_ref": "image-d49ee9dbd2a2d2cc43ca560df014be77de20456c-2400x1350-jpg", "_type": "reference"}}, "size": "lg"}, {"_key": "k052", "_type": "socialItem", "caption": "Tampere City Festival 2026", "href": "https://www.instagram.com/ahtiwater/", "image": {"_type": "image", "asset": {"_ref": "image-b9c15e9478ac1e33c5a0383683da2e112c523ef9-1600x2000-jpg", "_type": "reference"}}, "size": "md"}, {"_key": "k053", "_type": "socialItem", "caption": "Food Expo Hong Kong", "href": "https://www.instagram.com/ahtiwater/", "image": {"_type": "image", "asset": {"_ref": "image-b792f417f325205a8d10b5942acdb629a17f1d46-2000x1400-jpg", "_type": "reference"}}, "size": "lg"}, {"_key": "k054", "_type": "socialItem", "caption": "On the lawn", "href": "https://www.instagram.com/ahtiwater/", "image": {"_type": "image", "asset": {"_ref": "image-bd0e56f4585071e78484b6feb0dcaa5935b707fd-2000x1500-jpg", "_type": "reference"}}, "size": "md"}, {"_key": "k055", "_type": "socialItem", "caption": "Official Backstage Water", "href": "https://www.instagram.com/ahtiwater/", "image": {"_type": "image", "asset": {"_ref": "image-8bf262b6d4ee9ac72df8e3308900b85d9a2c721d-1600x2000-jpg", "_type": "reference"}}, "size": "lg"}, {"_key": "k056", "_type": "socialItem", "caption": "Helsinki Fashion Evening", "href": "https://www.instagram.com/ahtiwater/", "image": {"_type": "image", "asset": {"_ref": "image-0a3053e9fd29d7a9011dc5c3f18bde2a1118ce0b-1600x1600-jpg", "_type": "reference"}}, "size": "md"}, {"_key": "k057", "_type": "socialItem", "caption": "Official Backstage Water", "href": "https://www.i